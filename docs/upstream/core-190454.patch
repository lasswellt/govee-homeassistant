+def _stale_owner(
+    marketplace: MarketplaceManager, manifest: dict[str, Any] | str | None
+) -> IntegrationRepository:
+    """Register a repository holding a record of the domain, with a manifest on disk."""
+    other = IntegrationRepository(marketplace, "test/old-owner")
+    other.data.id = "1337"
+    other.data.domain = "example"
+    other.data.installed = True
+    other.data.installed_version = "1.0.0"
+    marketplace.repositories.register(other)
+
+    if manifest is not None:
+        directory = Path(other.localpath)
+        directory.mkdir(parents=True)
+        (directory / "manifest.json").write_text(
+            manifest if isinstance(manifest, str) else json.dumps(manifest)
+        )
+    return other
+
+
+@pytest.mark.parametrize(
+    ("manifest", "installed_version"),
+    [
+        (
+            {
+                "documentation": f"https://github.com/{REPOSITORY_INTEGRATION}/blob/main/README.md",
+                "issue_tracker": "https://example.com/issues",
+                "version": "1.0.0",
+            },
+            None,
+        ),
+        (
+            {
+                "issue_tracker": f"https://www.GitHub.com/{REPOSITORY_INTEGRATION.upper()}/issues",
+                "version": "1.0.0",
+            },
+            None,
+        ),
+        ({"version": "2.0.0"}, "2.0.0"),
+    ],
+    ids=["documentation", "issue_tracker", "version"],
+)
+async def test_integration_domain_owned_by_a_stale_record(
+    marketplace: MarketplaceManager,
+    caplog: pytest.LogCaptureFixture,
+    manifest: dict[str, Any],
+    installed_version: str | None,
+) -> None:
+    """Test a record the files on disk no longer belong to does not block the install."""
+    repository = marketplace.repositories.get_by_full_name(REPOSITORY_INTEGRATION)
+    repository.data.domain = "example"
+    repository.data.installed_version = installed_version
+    other = _stale_owner(marketplace, manifest)
+
+    with patch.object(marketplace.data, "async_write") as write:
+        await repository.async_pre_install()
+
+    assert not other.data.installed
+    assert other.data.installed_version is None
+    write.assert_awaited_once()
+    assert "test/old-owner" in caplog.text
+    assert REPOSITORY_INTEGRATION in caplog.text
+
+
+@pytest.mark.parametrize(
+    "manifest",
+    [
+        {
+            "documentation": "https://github.com/test/old-owner",
+            "issue_tracker": f"https://github.com/{REPOSITORY_INTEGRATION}/issues",
+            "version": "2.0.0",
+        },
+        {"documentation": f"https://github.com/{REPOSITORY_INTEGRATION}-fork/wiki"},
+        {"version": "1.0.0"},
+        None,
+        "{not json",
+    ],
+    ids=[
+        "names_the_other_repository",
+        "names_a_longer_repository",
+        "same_version_as_the_other",
+        "missing",
+        "unreadable",
+    ],
+)
+async def test_integration_domain_owned_when_the_files_are_not_ours(
+    marketplace: MarketplaceManager, manifest: dict[str, Any] | str | None
+) -> None:
+    """Test the other record stays when the files on disk do not show it is stale."""
+    repository = marketplace.repositories.get_by_full_name(REPOSITORY_INTEGRATION)
+    repository.data.domain = "example"
+    repository.data.installed_version = "1.0.0"
+    other = _stale_owner(marketplace, manifest)
+
+    with pytest.raises(MarketplaceError) as exc_info:
+        await repository.async_pre_install()
+
+    assert exc_info.value.translation_key == "integration_owned"
+    assert exc_info.value.translation_placeholders["owner"] == "test/old-owner"
+    assert other.data.installed
+    assert other.data.installed_version == "1.0.0"
+
