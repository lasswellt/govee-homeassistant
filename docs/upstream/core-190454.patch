+def _read_installed_manifest(directory: Path) -> dict[str, Any] | None:
+    """Return the manifest.json an integration has on disk, None when unusable."""
+    try:
+        return json_loads_object(
+            (directory / RepositoryFile.MANIFEST_JSON).read_text(encoding="utf-8")
+        )
+    except OSError, ValueError:
+        return None
+
+
+def _manifest_names_repository(manifest: dict[str, Any], full_name: str) -> bool:
+    """Return if the documentation or issue tracker of a manifest is on GitHub."""
+    address = re.compile(
+        rf"https?://(?:www\.)?github\.com/{re.escape(full_name)}(?:[/?#]|$)",
+        re.IGNORECASE,
+    )
+    return any(
+        isinstance(url := manifest.get(key), str) and address.match(url)
+        for key in ("documentation", "issue_tracker")
+    )
+
