+    async def _async_installed_by_this_repository(self, other: Repository) -> bool:
+        """Return if the files of an installed domain came from this repository.
+
+        The record of another repository for the same domain can be left over
+        from before the integration was installed from this one, the files on
+        disk then say which of the two they belong to.
+        """
+        manifest = await self.marketplace.hass.async_add_executor_job(
+            _read_installed_manifest, Path(other.localpath)
+        )
+        if manifest is None or _manifest_names_repository(
+            manifest, other.data.full_name
+        ):
+            return False
+
+        if _manifest_names_repository(manifest, self.data.full_name):
+            return True
+
+        version = manifest.get("version")
+        return (
+            isinstance(version, str)
+            and version == self.data.installed_version
+            and version != other.data.installed_version
+        )
 
